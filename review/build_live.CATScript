Sub CloseDrafts()
 Dim j,doc
 For j=CATIA.Documents.Count To 1 Step -1
  Set doc=CATIA.Documents.Item(j)
  If InStr(doc.FullName,"\CAD_Project\live_parts\")>0 Then doc.Close
 Next
End Sub

